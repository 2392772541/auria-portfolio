# Local runtime
PORT=3101
AURIA_DATA_DIR=./data
NODE_ENV=development
SESSION_TTL_MS=43200000

# Required only for administrator login
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Optional: contact-form notification to Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_HOME_CHANNEL=

# Optional scripts
AURIA_BACKUP_DIR=./backups
AURIA_AUDIT_BASE=http://127.0.0.1:3101
AURIA_DB=./data/auria.sqlite

# 首页文本数字分身。密钥只保存在服务端环境变量，禁止写进前端或数据库。
DIGITAL_AVATAR_API_KEY=
DIGITAL_AVATAR_BASE_URL=https://ai.nbcodex.com/v1
DIGITAL_AVATAR_MODEL=gpt-5.6-sol
DIGITAL_AVATAR_REASONING_EFFORT=medium
